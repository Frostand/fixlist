# Public client configuration only. Copy to ignored .env.local AFTER owner setup.
# Blank values keep real auth unavailable and preserve explicit local demos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Root URL of the SAME web origin serving this build, no query/hash/path.
VITE_AUTH_WEB_REDIRECT_URL=http://127.0.0.1:5173/
VITE_AUTH_NATIVE_REDIRECT_URL=app.fixlist.demo://auth/callback
# Enable each only after the matching Supabase/provider/dashboard/native gates.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_WEB_ENABLED=false
VITE_AUTH_APPLE_NATIVE_ENABLED=false
# Never place service_role, sb_secret, SMTP, Google/Apple secrets, .p8, or signing keys here.
