diff -ruN a/Sources/FluidAudio/Shared/ProbeOfflineAssets.swift b/Sources/FluidAudio/Shared/ProbeOfflineAssets.swift
--- a/Sources/FluidAudio/Shared/ProbeOfflineAssets.swift	1969-12-31 19:00:00
+++ b/Sources/FluidAudio/Shared/ProbeOfflineAssets.swift	2026-10-24 22:22:29
@@ -0,0 +1,56 @@
+// MODIFIED 2026-10-25 for the isolated FixList voice probe: required local assets; runtime networking disabled.
+import Foundation
+
+/// Isolated probe API. Configure exactly once, after manifest verification, before initializing Kokoro.
+/// No global cache, CWD fallback, asset creation, or network transport is permitted.
+public enum ProbeOfflineAssets {
+    private final class Storage: @unchecked Sendable {
+        let lock = NSLock()
+        var root: URL?
+    }
+    private static let storage = Storage()
+    public static func configure(root: URL) throws {
+        guard root.isFileURL else { throw TTSError.processingFailed("Offline root must be a local file URL") }
+        let canonical = root.standardizedFileURL.resolvingSymlinksInPath()
+        var directory: ObjCBool = false
+        guard FileManager.default.fileExists(atPath: canonical.path, isDirectory: &directory), directory.boolValue else {
+            throw TTSError.modelNotFound("Offline asset root missing")
+        }
+        storage.lock.lock()
+        defer { storage.lock.unlock() }
+        if let previous = storage.root, previous != canonical {
+            throw TTSError.processingFailed("Offline root cannot change within a process")
+        }
+        storage.root = canonical
+    }
+    public static func rootURL() throws -> URL {
+        storage.lock.lock()
+        defer { storage.lock.unlock() }
+        guard let root = storage.root else { throw TTSError.modelNotFound("Offline asset root not configured") }
+        return root
+    }
+    public static func require(_ relative: String) throws -> URL {
+        guard !relative.hasPrefix("/"), !relative.split(separator: "/").contains("..") else {
+            throw TTSError.processingFailed("Invalid offline asset path")
+        }
+        let root = try rootURL()
+        let file = root.appendingPathComponent(relative).resolvingSymlinksInPath()
+        guard file.path.hasPrefix(root.path + "/"), FileManager.default.fileExists(atPath: file.path) else {
+            throw TTSError.modelNotFound("Missing offline asset: \(relative)")
+        }
+        return file
+    }
+    static func blockedData() async throws -> (Data, URLResponse) {
+        throw TTSError.processingFailed("ALL runtime networking disabled in isolated voice probe")
+    }
+    static func blockedDownload() async throws -> (URL, URLResponse) {
+        throw TTSError.processingFailed("ALL runtime networking disabled in isolated voice probe")
+    }
+}
+
+extension ProbeOfflineAssets {
+    /// Probe-only explicit preload, so a covered phrase still validates both local G2P models.
+    public static func validateG2P() async throws {
+        try await G2PModel.shared.ensureModelsAvailable()
+    }
+}
