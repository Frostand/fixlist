{
  "name": "fixlist-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "vitest run scripts/setup.test.mjs scripts/verify-ios-model.test.mjs",
    "ios:model:check": "/bin/sh scripts/verify-ios-model.sh",
    "ios:sync": "npm run ios:model:check && npm run build && cap sync ios",
    "ios:demo": "npm run ios:demo:stage && npm run ios:sync && npm run ios:demo:install",
    "ios:demo:stage": "node scripts/ios-demo-scan.mjs --stage ios/DerivedData/fixlist-demo-scan-stage viennese-v2",
    "ios:demo:install": "node scripts/ios-demo-scan.mjs --install-staged ios/DerivedData/fixlist-demo-scan-stage",
    "i18n:status": "node scripts/i18n/cli.mjs status",
    "i18n:export": "node scripts/i18n/cli.mjs export",
    "i18n:import": "node scripts/i18n/cli.mjs import"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@sparkjsdev/spark": "2.3.1",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
